{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Evaluation Dataset Sample Schema",
  "description": "Schema for one evaluation sample in the complex industry-document GraphRAG project.",
  "type": "object",
  "required": [
    "sample_id",
    "question",
    "question_type",
    "difficulty",
    "modalities",
    "gold_answer",
    "expected_answer_points",
    "expected_evidence",
    "evaluation"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "Unique sample ID, for example EVAL-0001."
    },
    "question": {
      "type": "string",
      "description": "User-facing question."
    },
    "question_type": {
      "type": "string",
      "enum": [
        "fact",
        "entity_relation",
        "cross_paragraph",
        "cross_document",
        "global_summary",
        "table",
        "image",
        "causal_reasoning",
        "numeric",
        "comparison",
        "multi_hop"
      ],
      "description": "Main evaluation category."
    },
    "sub_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional fine-grained type, for example pressure_threshold or installation_diagram."
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "description": "Difficulty level based on evidence count, modality, and reasoning depth."
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text",
          "table",
          "image",
          "formula",
          "ocr",
          "caption"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Modalities required to answer the question."
    },
    "gold_answer": {
      "type": "string",
      "description": "Reference answer. Used for answer-level evaluation."
    },
    "expected_answer_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Key facts that a correct answer should include."
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "document_id",
          "file_name",
          "evidence_text",
          "content_type"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "Unique evidence ID inside this sample, for example E1."
          },
          "document_id": {
            "type": "string",
            "description": "Source document ID."
          },
          "file_name": {
            "type": "string",
            "description": "Source file name."
          },
          "chunk_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Expected chunk ID when known. It can be omitted before indexing."
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "image",
              "formula",
              "ocr",
              "caption"
            ],
            "description": "Evidence content type."
          },
          "chapter": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source chapter when known."
          },
          "section": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source section when known."
          },
          "page_start": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Start page for PDF grounding."
          },
          "page_end": {
            "type": [
              "integer",
              "null"
            ],
            "description": "End page for PDF grounding."
          },
          "bbox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Optional PDF bounding box: [x1, y1, x2, y2]."
          },
          "evidence_text": {
            "type": "string",
            "description": "Exact or near-exact evidence span expected in retrieved context."
          },
          "must_hit": {
            "type": "boolean",
            "default": true,
            "description": "Whether this evidence is required for full context recall."
          }
        },
        "additionalProperties": false
      },
      "description": "Gold evidence used for retrieval-level evaluation."
    },
    "recommended_routes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bm25",
          "vector",
          "graph",
          "hybrid",
          "hybrid_rerank",
          "query_router",
          "table_filter",
          "image_filter"
        ]
      },
      "uniqueItems": true,
      "description": "Expected useful retrieval strategies. Used for analysis, not for scoring."
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Facts that should not appear in a correct answer."
    },
    "evaluation": {
      "type": "object",
      "required": [
        "retrieval_metrics",
        "answer_metrics"
      ],
      "properties": {
        "retrieval_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hit_at_k",
              "recall_at_k",
              "mrr",
              "context_precision",
              "context_recall"
            ]
          },
          "minItems": 1,
          "description": "Retrieval-level metrics to compute."
        },
        "answer_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "answer_point_coverage",
              "faithfulness",
              "answer_relevance"
            ]
          },
          "minItems": 1,
          "description": "Answer-level metrics to compute."
        },
        "top_k_values": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            1,
            3,
            5,
            10
          ],
          "description": "K values used by Hit@K, Recall@K, and MRR analysis."
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form tags such as safety, pressure, maintenance, or figure."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Annotation notes."
    }
  },
  "additionalProperties": false
}
